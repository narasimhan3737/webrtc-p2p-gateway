# Host LAN IP used by Coturn (--external-ip) and the frontend TURN URL.
# Required for MEDIA_MODE=p2p multi-device / TURN relay tests.
TURN_EXTERNAL_IP=192.168.1.109
CORS_ORIGIN=https://4341-210-18-156-99.ngrok-free.app
# Backend
PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=secretpassword
DATABASE_NAME=concept_pro
REDIS_URL=redis://localhost:6379
JWT_SECRET=webrtc-poc-dev-secret-change-me
CORS_ORIGIN=http://localhost:3000

# Media path: dm (DM Mediaserver live NVR) or p2p (webcam simulator + Socket.IO)
MEDIA_MODE=p2p
DM_MEDIASERVER_API_BASE=http://127.0.0.1:1984
DM_MEDIASERVER_PUBLIC_BASE=http://127.0.0.1:1984

# To use P2P simulator instead:
# MEDIA_MODE=p2p
# (also start Redis + Coturn — see README)

# Frontend (copy into frontend/.env)
VITE_API_URL=http://localhost:3001
VITE_SIGNALING_URL=http://localhost:3001
VITE_DM_MEDIASERVER_BASE=http://127.0.0.1:1984
VITE_TURN_HOST=127.0.0.1
VITE_TURN_USERNAME=poc_user
VITE_TURN_CREDENTIAL=poc_password
